{
  "apiPath": "api::doc.doc",
  "endpoint": "docs",
  "fields": [
    "title",
    "description",
    "path",
    "content",
    "deployment_status",
    "date",
    "published_date",
    "updated_date",
    "meta_title",
    "image",
    "doc_type",
    "hide_table_of_contents"
  ],
  "required": ["title", "description"],
  "hasRelatedArticles": true,
  "relations": {
    "authors": {
      "endpoint": "authors",
      "matchField": "key",
      "frontmatterField": "authors"
    },
    "tags": {
      "endpoint": "tags",
      "matchField": "key",
      "frontmatterField": "tags",
      "filterKey": true,
      "matchValue": true
    },
    "keywords": {
      "endpoint": "keywords",
      "matchField": "key",
      "frontmatterField": "keywords",
      "filterKey": true,
      "matchValue": true
    }
  }
}
